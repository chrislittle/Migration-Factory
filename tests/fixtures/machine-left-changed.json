{
  "_comment": [
    "DELETE-CHANGED-FREED-1. Is a machine left CHANGED, with nothing that mended it",
    "since? A stopped machine: the stop that still describes it says changed, or a",
    "data disk swap is left. A machine left out (SKIPPED): the same question, asked",
    "of the record as the machine stood when it was left out, with every restore",
    "and data disk swap on the record now. Decided in TWO places: the engine",
    "(Test-VmfMachineLeftChanged, which keeps the claim and, at Delete this",
    "migration, the safety copies) and the run page (machineLeftChanged in",
    "migrations.html, which names the machine in the dialog Delete this migration).",
    "Both are held to this one list: tests/unit/DeleteChangedFreed.Tests.ps1 and",
    "tests/js/delete-changed-freed-real.test.js."
  ],
  "cases": [
    { "why": "POWER-ONLY-CHANGED-1: left out after a stop whose power state is owed: changed, until the product returns it",
      "doc": { "state": "SKIPPED", "history": [
        { "tsUtc": "2026-11-06T10:00:00Z", "state": "FAILED_NEEDS_ATTENTION", "outcome": "ok", "reasonCode": "rollbackDisksBeforeMoveNotMade", "machineState": "changed", "powerNotPutBack": "PowerState/deallocated" },
        { "tsUtc": "2026-11-06T10:05:00Z", "state": "SKIPPED", "outcome": "skip" } ] },
      "expected": true },
    { "why": "POWER-ONLY-CHANGED-1: left out, and the product returned its power state since: as it was",
      "doc": { "state": "SKIPPED", "history": [
        { "tsUtc": "2026-11-06T10:00:00Z", "state": "FAILED_NEEDS_ATTENTION", "outcome": "ok", "reasonCode": "rollbackDisksBeforeMoveNotMade", "machineState": "changed", "powerNotPutBack": "PowerState/deallocated" },
        { "tsUtc": "2026-11-06T10:05:00Z", "state": "SKIPPED", "outcome": "skip" },
        { "tsUtc": "2026-11-06T10:09:00Z", "state": "SKIPPED", "outcome": "ok", "machineState": "untouched" } ] },
      "expected": false },
    { "why": "POWER-ONLY-CHANGED-1: closed out part way by Stop this migration, its power state owed: changed",
      "doc": { "state": "SKIPPED", "history": [
        { "tsUtc": "2026-11-06T10:00:00Z", "state": "PRECHECK", "outcome": "ok" },
        { "tsUtc": "2026-11-06T10:05:00Z", "state": "SKIPPED", "outcome": "skip", "machineState": "changed", "powerNotPutBack": "PowerState/running" } ] },
