{
  "_comment": [
    "REGIONAL-QUOTA-REQUESTED-PAGE-1. Has an increase of the Total Regional",
    "vCPUs quota been requested for this quota record, and does it still wait?",
    "The engine writes the answer (Request-VmfQuota); the dashboard reads it",
    "(VmfHelp.claimRegionalRequested), and the migration page's capacity card",
    "then shows the regional row as Increase requested, as the family row of",
    "the same record does. Before, the card showed Headroom verified with the",
    "old usage while the request waited.",
    "The engine has no reader of this question, so it has no twin. What holds",
    "the two sides together is this list: each case with an 'engine' name is",
    "the record Request-VmfQuota writes in that situation, and",
    "tests/unit/RegionalQuotaRequestedPage.Tests.ps1 runs that situation and",
    "checks the record it writes against the case. tests/js/regional-quota.test.js",
    "checks every case's answer against help.js. Nothing here judges the figures."
  ],
  "cases": [
    { "engine": "regional-own-pending",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "regional-quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": "/quota-requests/cores", "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": null, "regionalRequestedUtc": null } },
      "requested": true,
      "why": "the family fits, and the request of the record's own reason is the regional one" },
    { "engine": "regional-own-approved",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "regional-quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": null, "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": null, "regionalRequestedUtc": null } },
      "requested": true,
      "why": "Azure approved the regional request at once, so it gave no request id; the next quota check reads the new limit" },
    { "engine": "both-pending",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": "/quota-requests/standardDSv6Family", "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": "/quota-requests/cores", "regionalRequestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": true,
      "why": "the family request is the record's own, and the regional request was filed beside it" },
    { "engine": "both-approved",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": null, "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": null, "regionalRequestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": true,
      "why": "Azure approved both at once: no request id, and the time says the regional request was filed" },
    { "engine": "family-refused-region-filed",
      "claim": { "state": "BLOCKED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": null, "requestedUtc": null,
                            "regionalRequestId": "/quota-requests/cores", "regionalRequestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": true,
      "why": "the family was refused and stays blocked, and the regional request waits" },
    { "engine": "region-refused-family-filed",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "requestId": "/quota-requests/standardDSv6Family", "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": null, "regionalRequestedUtc": null } },
      "requested": false,
      "why": "Azure refused the regional request, so no regional request waits" },
    { "engine": "family-only",
      "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": false,
                 "quota": { "requestId": "/quota-requests/standardDSv6Family", "requestedUtc": "2026-11-06T10:00:00Z",
                            "regionalRequestId": null, "regionalRequestedUtc": null } },
      "requested": false,
      "why": "the region has room, so only the family was requested" },
    { "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall",
                 "quota": { "requestId": "/quota-requests/standardDSv6Family", "requestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": false,
      "why": "a record written before v14 has no regional request fields, and the family request is not a regional one" },
    { "claim": { "state": "BLOCKED", "blockReason": "regional-quota-shortfall",
                 "quota": { "requestId": null, "regionalRequestId": null, "regionalRequestedUtc": null } },
      "requested": false,
      "why": "short of the region, and nothing requested yet" },
    { "claim": { "state": "BLOCKED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "regionalRequestId": "/quota-requests/cores", "regionalRequestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": true,
      "why": "the family is short, the region is short for the same machines, and the regional request is filed" },
    { "claim": { "state": "QUOTA_VERIFIED", "blockReason": "regional-quota-shortfall",
                 "quota": { "requestId": "/quota-requests/cores" } },
      "requested": false,
      "why": "a quota check after the request wrote the record again: nothing waits" },
    { "claim": { "state": "RESERVED", "blockReason": null,
                 "quota": { "regionalRequestId": "/quota-requests/cores", "regionalRequestedUtc": "2026-11-06T10:00:00Z" } },
      "requested": false,
      "why": "a record past the quota is history for the request" },
    { "claim": { "state": "RELEASED", "blockReason": "regional-quota-shortfall",
                 "quota": { "requestId": "/quota-requests/cores" } },
      "requested": false,
      "why": "a released record is history" },
    { "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "regionalRequestId": "", "regionalRequestedUtc": "  " } },
      "requested": false,
      "why": "empty text names no request" },
    { "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true,
                 "quota": { "regionalRequestId": true, "regionalRequestedUtc": 1 } },
      "requested": false,
      "why": "only the text the schema gives counts" },
    { "claim": { "state": "QUOTA_REQUESTED", "blockReason": "quota-shortfall", "regionalShort": true, "quota": null },
      "requested": false,
      "why": "a record with no quota object names no request" },
    { "claim": { "blockReason": "regional-quota-shortfall" },
      "requested": false,
      "why": "a record with no state is not waiting for anything" },
    { "claim": null, "requested": false, "why": "no record" }
  ]
}
