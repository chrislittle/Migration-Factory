<?xml version="1.0" encoding="utf-8"?>
<!--
  HOST-1: the response headers a storage static website simply cannot serve.
  This is the concrete reason the dashboard moved off storage: the page holds
  an access token in browser memory and was being served with no
  Content-Security-Policy at all.

  NOTE THE ATTRIBUTE NAME. IIS customHeaders use value=, NOT content=.
  content= is the HTML <meta> form; IIS rejects the unknown attribute as a
  configuration error, which surfaces as a blanket HTTP 500 on EVERY request -
  including plain static files - with nothing pointing at web.config as the
  cause. Deploying without this file is what isolated it.

  Default documents are set by the platform template's siteConfig, not here:
  a <remove> or <clear> for something the parent config has not defined is
  itself a configuration error rather than a no-op. The .json mapping below is
  ADDED without a preceding <remove> for exactly that reason - and it is not
  optional: IIS 404s any extension it has no MIME type for, so without it the
  page loads and then cannot fetch its own configuration.

  The policy names each host the browser must reach: the service (the
  facade API), Entra sign-in, Microsoft Graph and Azure Resource Manager.
  CSP-AZUREWEBSITES-1: the service is NOT a wildcard on azurewebsites.net -
  App Service names are first-come across all of Azure, so a wildcard admits
  sites anybody can create. The word in braces is a marker: the publish
  (tools/Deploy-VmfDashboard.ps1, through infra/Get-VmfDashboardWebConfig.ps1)
  writes the origin of the apiUrl it gives the page in its place, or removes
  it when no service is deployed. tests/unit/CspServiceHost.Tests.ps1 fails on
  a wildcard host in any directive.
  CSP-INLINE-1: script-src is 'self' alone. Every page keeps its script in a
  file with the page's name (wizard.html loads wizard.js), and no markup has
  an inline event attribute, so the browser refuses any script that reaches
  a page through a value that was not escaped. tests/unit/CspInline.Tests.ps1
  fails on an inline block, an event attribute or 'unsafe-inline' here.
  style-src keeps 'unsafe-inline': the pages set style="" attributes, and the
  run report the Reports page shows in a frame carries its own style block -
  STYLE-INLINE-1 tracks taking it away.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' {vmf-service-origin} https://login.microsoftonline.com https://graph.microsoft.com https://management.azure.com; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>
    <!-- HOME-1: say which page serves the root, rather than relying on the
         IIS default list. index.html is the overview; the list also decides
         what happens if a file called default.htm ever lands here. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- BRAND-1: the logo. IIS 404s an extension it has no map for, whatever
           the file is - which is how the dashboard once loaded and could not
           read its own .json configuration. A missing mark would be quieter
           and just as wrong. -->
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!-- DOC-4: the manual is Markdown pages the reader fetches; IIS has no
           map for .md and answers 404 without one. -->
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <!-- DARK-1: .css is NOT mapped here on purpose. IIS maps it by default,
           and a <remove> for something the parent already defines - or does
           not - is itself a configuration error that surfaces as HTTP 500 on
           EVERY request. .json needed a map because the deployed image had
           none; .css does not. The deploy verifies it fetches instead. -->
      <!--
        Found indirectly: a fix was deployed and the browser kept
        serving the old page, so the change looked like it had not worked.
        Without a Cache-Control header IIS lets the browser cache by heuristic,
        which means every dashboard update needs a hard refresh - and a
        customer would read a stale page as a broken feature.

        DisableCache sends "no-cache", which is REVALIDATE, not "never store":
        the browser keeps its copy and asks whether it is still current, so an
        unchanged page costs a 304 and a changed one arrives immediately.
      -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
